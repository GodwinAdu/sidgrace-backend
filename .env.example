# Copy this file to .env and fill in the values. Never commit .env.

# --- Server ---
PORT=5000
# 127.0.0.1 = only this PC can call the API (recommended: the Next.js app calls it server-side)
HOST=127.0.0.1
NODE_ENV=production

# --- Database (same local MongoDB as the frontend; DB name "SidGrace" is set in code) ---
MONGODB_URL=mongodb://127.0.0.1:27017

# --- SMSOnlineGH (https://portal.smsonlinegh.com) ---
# API key: portal -> account settings -> API configuration -> generate API key
SMSONLINEGH_API_KEY=
# Sender ID: must be requested and APPROVED in the portal (SMS Messaging -> Sender Names), max 11 chars
SMSONLINEGH_SENDER_ID=
# Optional override (default shown)
SMSONLINEGH_BASE_URL=https://api.smsonlinegh.com/v5
